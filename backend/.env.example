# Fraud Forensic Replay - backend environment template.
#
# Copy this file to `backend/.env` and paste your secrets there. The .env
# file is gitignored (root .gitignore line: `.env`). Never commit it.
#
# Loaded by python-dotenv at the top of seed.py + main.py.

# Google Maps Platform - Places API (New).
# - If you have the Maps "Demo Key" (no credit card), paste it here.
# - If you have a billing-enabled API key, that also works.
# - Leave blank to skip Places enrichment in seed.py (falls back to the
#   hand-rolled placeholder merchant names).
GOOGLE_PLACES_API_KEY=
