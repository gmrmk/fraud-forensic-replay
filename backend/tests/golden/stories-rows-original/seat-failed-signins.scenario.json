{
  "id": "seat-failed-signins",
  "label": "Platform · failed sign-ins, then a grant",
  "db": "data/seat-failed-signins.db",
  "home": { "lat": 42, "lng": -22, "zoom": 2 },
  "nodes": [
    {
      "kind": "org", "label": "Organisation", "palette": "#4da3ff", "source": "json",
      "file": "data/seat-failed-signins/org.json",
      "primary": "${org_name}", "secondary": "${org_id}",
      "pivotable": ["org_id"]
    },
    {
      "kind": "seat", "label": "Seat", "palette": "#9aa5b1", "source": "json",
      "file": "data/seat-failed-signins/seat.json",
      "primary": "${seat_name}", "secondary": "${seat_id}",
      "pivotable": ["seat_id"],
      "sections": [
        { "id": "seat", "label": "Seat", "fields": ["seat_id", "seat_name", "signins_total", "addresses", "first_signin_on"] }
      ]
    },
    {
      "kind": "signin", "label": "Sign-in", "palette": "#7ee787", "source": "json",
      "file": "data/seat-failed-signins/signin.json",
      "timestamp": "timestamp",
      "primary": "${outcome} · ${network_id}", "secondary": "${seat_id} · ${attempts} in ${window_min} min",
      "pivotable": ["seat_id", "network_id"],
      "sections": [
        { "id": "sign-in", "label": "Sign-in", "fields": ["seat_id", "network_id", "outcome", "attempts", "window_min", "timestamp"] }
      ]
    },
    {
      "kind": "request_sample", "label": "Request", "palette": "#56d4dd", "source": "json",
      "file": "data/seat-failed-signins/request_sample.json",
      "timestamp": "timestamp",
      "primary": "Request · ${network_id}", "secondary": "${seat_id}",
      "pivotable": ["seat_id", "network_id"],
      "sections": [
        { "id": "request", "label": "Request", "fields": ["seat_id", "network_id", "timestamp"] }
      ]
    },
    {
      "kind": "credential_event", "label": "Credential event", "palette": "#c4a1ff", "source": "json",
      "file": "data/seat-failed-signins/credential_event.json",
      "timestamp": "timestamp",
      "primary": "${event} · ${lifetime_h} h", "secondary": "${seat_id}",
      "pivotable": ["seat_id"],
      "sections": [
        { "id": "credential", "label": "Credential", "fields": ["seat_id", "event", "lifetime_h", "timestamp"] }
      ]
    },
    {
      "kind": "reset", "label": "Limit reset", "palette": "#ffa657", "source": "json",
      "file": "data/seat-failed-signins/reset.json",
      "timestamp": "timestamp",
      "primary": "Limit reset", "secondary": "${seat_id}",
      "pivotable": ["seat_id"],
      "sections": [
        { "id": "reset", "label": "Reset", "fields": ["seat_id", "timestamp"] }
      ]
    },
    {
      "kind": "usage_hour", "label": "Requests per hour", "palette": "#f5a623", "source": "json",
      "file": "data/seat-failed-signins/usage_hour.json",
      "timestamp": "timestamp",
      "primary": "${requests} requests", "secondary": "${seat_id}",
      "pivotable": ["seat_id"],
      "magnitude": "requests", "magnitudeLabel": "Requests", "magnitudeUnit": "requests",
      "sections": [
        { "id": "usage", "label": "Usage", "fields": ["seat_id", "requests", "timestamp"] }
      ]
    },
    {
      "kind": "decision", "label": "Decision", "palette": "#ff6b6b", "source": "json",
      "file": "data/seat-failed-signins/decision.json",
      "timestamp": "decided_at",
      "primary": "${outcome} · ${target_label}", "secondary": "${decided_by} · ${status}",
      "pivotable": ["seat_id"],
      "decision": { "status": "status", "outcome": "outcome", "note": "note", "actor": "decided_by", "target": "target_label", "key": "seat_id", "event": "event_ids" }
    }
  ],
  "rows": { "by": "seat_id", "member": "network_id" },
  "fields": {
    "seat_id": { "label": "Seat" },
    "network_id": { "label": "Network" }
  },
  "arrows": [],
  "rules": []
}
