{
  "id": "platform-access",
  "label": "Platform · key takeover",
  "db": "data/platform-access.db",
  "home": { "lat": 42, "lng": -22, "zoom": 2 },
  "annotations": [
    {
      "timestamp": "2026-06-08T12:40:00+00:00",
      "label": "Phishing email to admins (customer-reported)",
      "note": "Customer-reported after the fact: an email asking organisation admins to \"confirm your billing contact\" linked to a look-alike console sign-in page that asked for the password and the one-time code. An admin at the Austin organisation entered both on Monday morning. Reported context, not a platform record."
    }
  ],
  "nodes": [
    {
      "kind": "org", "label": "Organisation", "palette": "#4da3ff", "source": "json",
      "file": "data/platform-access/org.json",
      "coords": { "lat": "lat", "lng": "lng" },
      "primary": "${org_name} · ${city}, ${country}", "secondary": "${domain} · ${plan} · ${seats} seats",
      "pivotable": ["org_id"]
    },
    {
      "kind": "console_signin", "label": "Console sign-in", "palette": "#7ee787", "source": "json",
      "file": "data/platform-access/console_signin.json",
      "coords": { "lat": "lat", "lng": "lng" }, "timestamp": "timestamp",
      "primary": "${org_name} · ${ip_address}", "secondary": "${ip_asn} · ${device_id}",
      "pivotable": ["org_id", "seat_id", "session_id", "device_id", "ip_address", "ip_asn"],
      "path": true, "pathBy": "seat_id", "territory": false,
      "refs": { "org_id": ["org"] },
      "sections": [
        { "id": "sign-in", "label": "Sign-in", "fields": ["device_id", "ip_address", "ip_asn", "ip_type", "ip_country", "auth_method", "timestamp"] }
      ]
    },
    {
      "kind": "key_event", "label": "API key event", "palette": "#c4a1ff", "source": "json",
      "file": "data/platform-access/key_event.json",
      "coords": { "lat": "lat", "lng": "lng" }, "timestamp": "timestamp",
      "primary": "${org_name} · ${credential_id}", "secondary": "${event} by ${actor} · ${seat_id}",
      "pivotable": ["org_id", "seat_id", "credential_id", "session_id", "device_id", "ip_address", "ip_asn"],
      "refs": { "org_id": ["org"] },
      "sections": [
        { "id": "key", "label": "Key", "fields": ["credential_id", "event", "actor", "seat_id", "timestamp"] }
      ]
    },
    {
      "kind": "usage", "label": "Token usage", "palette": "#f5a623", "source": "json",
      "file": "data/platform-access/usage.json",
      "coords": { "lat": "lat", "lng": "lng" }, "timestamp": "timestamp",
      "primary": "$${spend_usd} · ${org_name}", "secondary": "${credential_id} · ${ip_asn}",
      "pivotable": ["org_id", "credential_id", "ip_asn"],
      "magnitude": "spend_usd", "magnitudeLabel": "Spend", "magnitudeUnit": "USD",
      "refs": { "org_id": ["org"] },
      "sections": [
        { "id": "usage", "label": "Usage", "fields": ["credential_id", "requests", "input_tokens", "output_tokens", "spend_usd", "timestamp"] }
      ]
    },
    {
      "kind": "decision", "label": "Decision", "palette": "#ff6b6b", "source": "json",
      "file": "data/platform-access/decision.json",
      "coords": { "lat": "lat", "lng": "lng" }, "timestamp": "decided_at",
      "primary": "${outcome} · ${target_label}", "secondary": "${decided_by} · ${status}",
      "pivotable": ["org_id"],
      "refs": { "org_id": ["org"], "event_ids": ["key_event", "usage"] },
      "decision": { "status": "status", "outcome": "outcome", "note": "note", "actor": "decided_by", "target": "target_label", "key": "org_id", "event": "event_ids" }
    }
  ],
  "rows": { "by": "org_id", "name": "org_name", "member": "credential_id" },
  "fields": {
    "org_id": { "label": "Organisation" },
    "credential_id": { "label": "API key" },
    "ip_asn": { "label": "Network" }
  },
  "lanes": [
    { "id": "usage", "depth": { "split": "ip_asn" } }
  ],
  "arrows": [],
  "rules": [
    {
      "id": "key-after-new-device",
      "label": "new-device key creation",
      "detector": "change-after-new-device", "change_label": "Key created",
      "signin_kind": "console_signin", "change_kind": "key_event",
      "subject_field": "seat_id", "session_field": "session_id", "device_field": "device_id",
      "ip_type_field": "ip_type", "ip_types": ["datacenter"], "window_min": 10,
      "verdict": "KEY TAKEOVER", "decision": "FLAG", "severity": 0.9,
      "sop": {
        "what": "An API key created within 10 minutes of a console sign-in in the same session, from a device never seen on that seat, on a data-center network.",
        "why": "",
        "brief": "NEW DEVICE · DATA CENTER · KEY CREATED IN SESSION. Revoke the key and expire the seat's console sessions. Verify with the admin on the number on file."
      }
    },
    {
      "id": "spend-burst",
      "label": "spend burst",
      "detector": "magnitude-burst",
      "kind": "usage", "subject_field": "credential_id", "baseline_field": "org_id", "value_field": "spend_usd",
      "multiple": 10, "min_run": 2, "floor": 25, "baseline_hours": 168,
      "subject_label": "API key", "value_label": "Spend", "unit_prefix": "$",
      "verdict": "SPEND BURST", "decision": "REVIEW", "severity": 0.8,
      "sop": {
        "what": "An API key whose hourly spend is at least 10 times the organisation's median hour over the prior week, and at least $25, for two or more hours in a row.",
        "why": "",
        "brief": "KEY AT 10 TIMES THE MEDIAN HOUR · TWO HOURS RUNNING. Check who created the key and from where. Confirm planned work with the organisation before revoking."
      }
    }
  ]
}
